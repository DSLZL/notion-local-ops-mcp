NOTION_LOCAL_OPS_HOST=127.0.0.1
NOTION_LOCAL_OPS_PORT=8766
NOTION_LOCAL_OPS_WORKSPACE_ROOT=/absolute/path/to/workspace
NOTION_LOCAL_OPS_STATE_DIR=~/.notion-local-ops-mcp
NOTION_LOCAL_OPS_AUTH_TOKEN=replace-me
NOTION_LOCAL_OPS_NGROK_COMMAND=ngrok
NOTION_LOCAL_OPS_NGROK_AUTHTOKEN=
NOTION_LOCAL_OPS_NGROK_DOMAIN=
NOTION_LOCAL_OPS_NGROK_REGION=
NOTION_LOCAL_OPS_NGROK_API_URL=http://127.0.0.1:4040/api/tunnels
# For ChatGPT web OAuth mode:
# NOTION_LOCAL_OPS_AUTH_MODE=oauth
# NOTION_LOCAL_OPS_PUBLIC_BASE_URL=https://your-public-mcp-host.example
# NOTION_LOCAL_OPS_OAUTH_LOGIN_TOKEN=
# NOTION_LOCAL_OPS_OAUTH_SCOPES=local-ops
# NOTION_LOCAL_OPS_OAUTH_TOKEN_TTL_SECONDS=86400
NOTION_LOCAL_OPS_COMMAND_TIMEOUT=120
NOTION_LOCAL_OPS_DEBUG_MCP_LOGGING=0
NOTION_LOCAL_OPS_GRACEFUL_SHUTDOWN_SECONDS=30
# Comma-separated list of extra directories that write_file is allowed to write to.
# Useful in containerized deployments where /tmp is safe but outside workspace root.
NOTION_LOCAL_OPS_EXTRA_WRITE_DIRS=/tmp
